.gradle
.gradle-user-home/
**/build/
!src/**/build/
run/
out/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# kotlin
.kotlin/

# IDEA config
.idea

/.codex-tmp/

.tmp
/actinium-scratchpad/
/.codex/
/docs/implementation-differences/

# Dev-run artifacts
/assets/
*.log

# JMH extracts its bundled Mesa EGL runtime here; keep the generated DLLs out of Git.
celeritas-common/build/jmh/mesa-windows-x64/

# Legacy location for locally unpacked Mesa EGL/GLES DLLs.
celeritas-common/jmh-natives/
/.tools/
